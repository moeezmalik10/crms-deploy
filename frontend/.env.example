# Copy to .env for running the website on your own PC. On Vercel, add the same names under
# Project -> Settings -> Environment Variables.
VITE_API_BASE=https://crms-backend.onrender.com
VITE_IDS_BASE=https://crms-ids.onrender.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# R4's Guacamole gateway (see guacamole/README.md) - leave unset until a real instance is
# deployed; the SSH section on the student session page hides itself without this.
VITE_GUACAMOLE_URL=
